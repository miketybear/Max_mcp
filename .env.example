# Maximo MAS 9.x Configuration
# Copy this file to .env and fill in your actual values

# Maximo Host URL (without trailing slash)
MAXIMO_HOST=https://your-maximo-host.com

# Maximo API Key
MAXIMO_API_KEY=your-api-key-here

# Optional: Username/Password authentication (alternative to API Key)
# MAXIMO_USERNAME=your-username
# MAXIMO_PASSWORD=your-password

# Optional: Timeout for API requests (in milliseconds)
MAXIMO_TIMEOUT=30000

# Optional: Number of retry attempts for failed requests
MAXIMO_MAX_RETRIES=3

# Optional: SSL certificate validation (set to false for self-signed certs in dev)
# MAXIMO_VALIDATE_SSL=true

# Optional: Enable response caching
CACHE_ENABLED=true

# Optional: Cache TTL (time to live) in seconds
CACHE_TTL=300

# Optional: Maximum number of cached entries
CACHE_MAX_SIZE=100

# Optional: Log level (error, warn, info, debug, verbose)
LOG_LEVEL=info

# Optional: Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
