{
  "name": "@themaximoguys/maximo-mcp",
  "version": "2.0.0",
  "description": "MCP server providing 175+ tools for IBM Maximo Asset Management — work orders, assets, inventory, service requests, and more",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "maximo-mcp": "dist/bundle.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc && npm run build:bundle",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --outfile=dist/bundle.js && esbuild src/cli.ts --bundle --platform=node --outfile=dist/cli.js",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "maximo",
    "ibm",
    "asset-management",
    "eam",
    "cmms",
    "work-orders",
    "oslc",
    "mas9",
    "model-context-protocol",
    "claude",
    "ai-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themaximoguys/maximo-mcp.git"
  },
  "homepage": "https://github.com/themaximoguys/maximo-mcp#readme",
  "bugs": {
    "url": "https://github.com/themaximoguys/maximo-mcp/issues"
  },
  "author": "TheMaximoGuys <hello@themaximoguys.com>",
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "node-cache": "^5.1.2",
    "uuid": "^13.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.19.12",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "msw": "^2.0.0",
    "prettier": "^3.0.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.2.0"
  }
}
